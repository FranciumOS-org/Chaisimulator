# ─────────────────────────────────────────────
#  مای پیکسل — تنظیمات محیط
#  این فایل رو کپی کن به .env و مقدارها رو عوض کن
#  cp .env.example .env
# ─────────────────────────────────────────────

# پورتی که سرور روش بالا میاد
PORT=3000

# ⚠️ حتماً عوضش کن — کلید امضای توکن‌هاست
# یه مقدار تصادفی بساز:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# مدت اعتبار توکن ورود
JWT_EXPIRES=30d

# آدرس سایت (برای کوکی و CORS و کال‌بک درگاه)
SITE_URL=http://localhost:3000

# دامنه‌های مجاز برای CORS — با کاما جدا کن
# در حالت پروداکشن دامنه واقعی رو بذار
CORS_ORIGIN=http://localhost:3000

# در پروداکشن روی 1 بذار تا کوکی فقط روی HTTPS ارسال بشه
SECURE_COOKIE=0


# ───── پیامک ─────
# console  = کد فقط توی لاگ سرور چاپ می‌شه (برای توسعه)
# kavenegar
# smsir
SMS_DRIVER=console
SMS_API_KEY=
SMS_SENDER=
SMS_TEMPLATE=mypixel-otp

# ⚠️ فقط برای توسعه: کد OTP رو توی پاسخ API برمی‌گردونه
# وقتی 1 باشه سقف درخواست کد پیامکی هم بالا می‌ره تا موقع تست به ۴۲۹ نخوری
# در پروداکشن حتماً 0
EXPOSE_OTP=0

# سقف درخواست کد پیامکی (پیش‌فرض: ۶ در پروداکشن، ۱۰۰ در حالت توسعه)
OTP_MAX=
OTP_WINDOW_MIN=10


# ───── مسیر دیتابیس ─────
# اگه خالی بذاری، پیش‌فرض ../data/mypixel.db استفاده می‌شه
DB_PATH=

# ───── درگاه پرداخت ─────
# این‌ها را می‌توانی از پنل مدیریت هم وارد کنی؛ مقدار پنل اولویت دارد.
SITE_URL=https://yourdomain.ir
ZARINPAL_MERCHANT=
ZIBAL_MERCHANT=

# ───── بکاپ ─────
BACKUP_DIR=../backups
BACKUP_KEEP=14
